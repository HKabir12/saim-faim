# এই ফাইলটি কপি করে .env.local নাম দিন, তারপর মান বসান।
DATABASE_URL=postgresql://postgres:password@localhost:5432/khatna
ADMIN_USERNAME=admin
# npm run hash -- "আপনার-পাসওয়ার্ড"  চালালে যে লাইন আসবে সেটা এখানে বসান।
ADMIN_PASSWORD_HASH=
# openssl rand -base64 32  দিয়ে বানানো একটা লম্বা গোপন লেখা।
AUTH_SECRET=
